{
  "name": "factory-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/serialize-json-ld.test.mjs",
    "test:hydration": "node --test tests/hydration.browser.test.mjs",
    "test:hydration:baseline": "node --test tests/hydration.baseline.browser.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "audit": "node scripts/audit.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.2",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "eslint": "10.13.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "pdf-lib": "1.17.1",
    "playwright": "1.64.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "typescript-eslint": "8.71.2",
    "vinext": "1.2.1",
    "vite": "8.3.4",
    "wrangler": "4.151.1"
  },
  "type": "module",
  "overrides": {
    "undici": "7.29.1"
  }
}
